{
  "buildCommand": "npm run build --prefix client && npm run build --prefix server",
  "outputDirectory": "server/dist",
  "env": {
    "NODE_ENV": "production"
  },
  "functions": {
    "server/dist/index.js": {
      "runtime": "nodejs20.x"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/server/dist/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/client/dist/$1"
    }
  ]
}
